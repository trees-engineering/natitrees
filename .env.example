# WhatsApp Business (Meta Cloud API) — alternative to Twilio for outbound calls
# Get these from Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=any_secret_string_you_choose

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Provider selection (swap these to switch providers)
LLM_PROVIDER=gemini
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Local server
PORT=3000

# Set these after running ngrok (see README)
PUBLIC_HTTP_URL=https://xxxx.ngrok-free.app
PUBLIC_WS_URL=wss://xxxx.ngrok-free.app/media-stream
